# Comma-delimited list of GitHub personal access tokens
GH_TOKEN_LIST=ghp_token1,ghp_token2

# Optional: NVD API key, raises the CVE API rate limit from 5 req/30s to 50 req/30s
NVD_API_KEY=

# Only for the LLM classification step (llm-filtering/run.py).
# Set the key for the --llm you use; --llm ollama needs none.
OPENAI_API_KEY=
GEMINI_API_KEY=

# for using the Zenodo management scripts
ZENODO_API_TOKEN=
ZENODO_API_ENDPOINT=https://zenodo.org
